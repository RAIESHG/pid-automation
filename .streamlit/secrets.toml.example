# Copy this file to secrets.toml and fill in your values.
# NEVER commit secrets.toml to git — it's in .gitignore.
#
# How to create a GitHub OAuth App:
#   1. Go to https://github.com/settings/developers
#   2. Click "New OAuth App"
#   3. Fill in:
#        Application name:             P&ID Automation
#        Homepage URL:                 http://localhost:8501
#        Authorization callback URL:   http://localhost:8501
#   4. Copy the Client ID and generate a Client Secret below.

[github]
client_id     = "YOUR_GITHUB_CLIENT_ID"
client_secret = "YOUR_GITHUB_CLIENT_SECRET"
redirect_uri  = "http://localhost:8501"
